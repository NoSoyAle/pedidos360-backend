# Configuración para docker-compose.prod.yml (NO subir valores reales a GitHub).
# Copia este archivo como .env y completa los valores.

# Base de datos (contenedor Postgres de la EC2)
DB_USERNAME=pedidos360
DB_PASSWORD=REEMPLAZAR_CONTRASENA_SEGURA

# Microsoft Entra ID
# Tenant (Directory) ID de tu organización
AZURE_ISSUER_URI=https://login.microsoftonline.com/TU_TENANT_ID/v2.0
# Client ID de la aplicación registrada para la API (backend)
AZURE_CLIENT_ID=TU_CLIENT_ID_API

# Configuración frontend (imagen del deploy-frontend.sh)
# API_URL_BASE=https://TU_API_GATEWAY.amazonaws.com
# MSAL_CLIENT_ID=TU_CLIENT_ID_SPA
# MSAL_TENANT_ID=TU_TENANT_ID